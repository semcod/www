[Unit]
Description=Semcod Frontend (nginx)
After=network-online.target semcod-network.service semcod-backend.service
Wants=network-online.target
Requires=semcod-backend.service

[Container]
ContainerName=semcod-frontend
Image=semcod-frontend:latest
AutoUpdate=registry
Network=semcod.network

PublishPort=3000

# Environment
Environment=VITE_PUBLIC_URL=https://semcod.com

# Labels for Traefik
Label=traefik.enable=true
Label=traefik.http.routers.semcod-web.rule=PathPrefix(`/`)
Label=traefik.http.routers.semcod-web.entrypoints=websecure
Label=traefik.http.routers.semcod-web.priority=1
Label=traefik.http.routers.semcod-web.tls=true
Label=traefik.http.routers.semcod-web.tls.certresolver=letsencrypt
Label=traefik.http.services.semcod-web.loadbalancer.server.port=3000

# Resource limits
MemoryLimit=128M
CPULimit=0.5

[Service]
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
