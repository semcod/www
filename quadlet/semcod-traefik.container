[Unit]
Description=Semcod Traefik Reverse Proxy
After=network-online.target semcod-network.service
Wants=network-online.target

[Container]
ContainerName=semcod-traefik
Image=docker.io/traefik:v3.3
AutoUpdate=registry
Network=semcod.network

PublishPort=80:80
PublishPort=443:443
PublishPort=8080:8080

# Config
Volume=/opt/semcod/traefik/traefik-prod.yml:/etc/traefik/traefik.yml:ro,Z
Volume=/opt/semcod/traefik/acme.json:/etc/traefik/acme.json:Z
Volume=/run/podman/podman.sock:/var/run/docker.sock:ro

# Labels for self-routing (dashboard)
Label=traefik.enable=true
Label=traefik.http.routers.traefik-dashboard.rule=PathPrefix(`/api`) || PathPrefix(`/dashboard`)
Label=traefik.http.routers.traefik-dashboard.entrypoints=websecure
Label=traefik.http.routers.traefik-dashboard.tls=true
Label=traefik.http.routers.traefik-dashboard.tls.certresolver=letsencrypt
Label=traefik.http.routers.traefik-dashboard.service=api@internal

# Resource limits
MemoryLimit=128M
CPULimit=0.5

[Service]
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
