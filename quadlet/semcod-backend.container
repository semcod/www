[Unit]
Description=Semcod Backend API
After=network-online.target semcod-network.service
Wants=network-online.target

[Container]
ContainerName=semcod-backend
Image=semcod-backend:latest
AutoUpdate=registry
Network=semcod.network

# Port mapping (internal 8000, exposed via Traefik)
PublishPort=8000

# Environment — secrets come from EnvFile, non-secret overrides inline
EnvFile=/opt/semcod/.env
Environment=PORT=8000
Environment=APP_URL=https://api.semcod.com
Environment=FRONTEND_URL=https://semcod.com
Environment=CORS_ORIGINS=https://semcod.com,https://api.semcod.com
Environment=GITHUB_OAUTH_SCOPE=repo,read:org
Environment=GITHUB_PRIVATE_KEY_PATH=/app/private-key.pem

# Database (PostgreSQL preferred, SQLite fallback via DB_PATH)
Environment=DATABASE_URL=
Environment=DB_PATH=/app/data/scans.db

# Task queue
Environment=REDIS_URL=redis://semcod-redis:6379/0

# Tuning
Environment=SCAN_HISTORY_LIMIT=100
Environment=REPOS_PER_PAGE=30
Environment=LARGE_FILE_THRESHOLD=300
Environment=SESSION_EXPIRE_HOURS=168
Environment=DEMO_MODE=0

# Persistent data
Volume=semcod-data.volume:/app/data
Volume=/opt/semcod/private-key.pem:/app/private-key.pem:ro,Z

# Health check
HealthCheckCmd=curl -f http://localhost:8000/api/health || exit 1
HealthCheckInterval=30s
HealthCheckTimeout=5s
HealthCheckStartPeriod=10s
HealthCheckRetries=3

# Labels for Traefik
Label=traefik.enable=true
Label=traefik.http.routers.semcod-api.rule=PathPrefix(`/api/`) || PathPrefix(`/auth/`) || PathPrefix(`/webhook/`) || PathPrefix(`/badge/`) || PathPrefix(`/report/`) || PathPrefix(`/mcp/`)
Label=traefik.http.routers.semcod-api.entrypoints=websecure
Label=traefik.http.routers.semcod-api.tls=true
Label=traefik.http.routers.semcod-api.tls.certresolver=letsencrypt
Label=traefik.http.services.semcod-api.loadbalancer.server.port=8000

# Security
ReadOnly=true
Volume=/app/data:/app/data
Volume=/tmp:/tmp

# Resource limits
MemoryLimit=512M
CPULimit=1.0

[Service]
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
