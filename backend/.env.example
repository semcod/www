# AI Cost Tracking Configuration
# Get your API key from: https://openrouter.ai/keys

# OpenRouter API Key (required for real cost calculation)
OPENROUTER_API_KEY=sk-or-v1-...

# Default AI model for cost analysis
LLM_MODEL=openrouter/qwen/qwen3.7-plus

# Optional: SaaS token for managed billing
# SAAS_TOKEN=your-saas-token

# GitHub OAuth (required for SaaS login)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# JWT session secret (change in production!)
SECRET_KEY=dev-secret-change-me

# Session expiration in hours (default: 168 = 7 days)
# SESSION_EXPIRE_HOURS=168

# Demo mode: allows login without GitHub (POST /auth/demo)
# DEMO_MODE=1
