# Serve the dynamic PHP portal as the site homepage.
DirectoryIndex index.php index.html

# Pretty per-project URLs:  /p/<repo>  ->  /repo.php?name=<repo>
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^p/([A-Za-z0-9._-]+)/?$ /repo.php?name=$1 [L,QSA]
</IfModule>

# Never serve the cache directory or local config over HTTP.
<IfModule mod_authz_core.c>
  <FilesMatch "^config\.local\.php$">
    Require all denied
  </FilesMatch>
</IfModule>
RedirectMatch 404 ^/cache/
